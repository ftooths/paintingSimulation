FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip build-essential cmake g++ libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY CMakeLists.txt pyproject.toml requirements.txt ./
COPY cpp ./cpp
COPY python ./python
COPY config ./config

RUN cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --config Release
RUN pip3 install --no-cache-dir -r requirements.txt

ENV PYTHONPATH=/app/python
ENV LOW_VRAM_MODE=true
CMD ["python3", "python/tests/test_mvp_suite.py"]
