FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake g++ libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY CMakeLists.txt pyproject.toml requirements.txt ./
COPY cpp ./cpp
COPY python ./python
COPY config ./config

RUN cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --config Release
RUN pip install --no-cache-dir -r requirements.txt

ENV PYTHONPATH=/app/python
EXPOSE 8000
CMD ["uvicorn", "paint_sim.api.main:create_fastapi_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
