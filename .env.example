# ============================================================================
# 2D Plastic-Model Paint & Finish Simulator — Environment Configuration
# Target Local Rig: AMD Ryzen 5 5600G, 32 GB RAM, NVIDIA RTX 3070 (8 GB VRAM)
# ============================================================================

EXECUTION_TRACK=track_b_hybrid
LOW_VRAM_MODE=true
VISION_MAX_DIM=1536
OMP_NUM_THREADS=12

# External User-Editable Prompt Configuration (Hot-Reloaded on Save)
PROMPTS_JSON_PATH=./config/prompts.json

# Google Gemini Vision API (Call 1 & Call 2, <= 2 calls per image)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MAX_CALLS=2

# Google Cloud Vertex AI — Nano Banana Dual-Image Post-Refinement
GCP_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp_service_account.json

# Google Drive Dataset Flywheel Archiver
GDRIVE_ENABLED=true
GDRIVE_FOLDER_ID=your_google_drive_folder_id
LOCAL_ARCHIVE_DIR=./data/archive
